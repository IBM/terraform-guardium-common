# K3S Installation - Example Configuration
# Copy this file to terraform.tfvars and fill in your values

# ============================================================================
# REQUIRED: Cluster Information
# ============================================================================
cluster_name  = "my-test-cluster"

# Master nodes
master_nodes = [
  "my-test-cluster-master1.fyre.ibm.com"
]

# Worker nodes
# Leave empty for single-node cluster
worker_nodes = []

# ============================================================================
# REQUIRED: SSH Credentials
# ============================================================================
ssh_user     = "root"                    # SSH username (default: root, env: K3S_SSH_USER)
ssh_password = "your-fyre-root-password"

# ============================================================================
# K3S Configuration
# ============================================================================
k3s_version          = "v1.32.3"  # Options: v1.32.3, v1.33.1, etc.
k3s_token            = "edge1234" # Cluster authentication token
k3s_airgap_install   = true
airgap_installation_path = ""     # Path to local K3S airgap binary files

# ============================================================================
# K3S Installation Options
# ============================================================================
k3s_install_options = {
  disable_traefik   = true    # Disable Traefik ingress controller
  taint_masters     = true    # Taint master nodes to prevent workload scheduling
  node_wait_timeout = "600s"  # Timeout for node readiness check
}

# ============================================================================
# SSH Connection Options
# ============================================================================
ssh_options = {
  connect_timeout       = 30  # SSH connection timeout in seconds
  server_alive_interval = 10  # Interval for keepalive messages
  server_alive_count    = 3   # Number of keepalive messages before disconnect
  # known_hosts_file    = "/path/to/known_hosts"  # Verify node SSH host keys; unset disables verification
}

# ============================================================================
# Installation Timeout
# ============================================================================
install_timeout_minutes = 45  # Maximum time for K3S installation

